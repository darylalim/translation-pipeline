# Secrets
.env

# Streamlit — ignore secrets and everything else under .streamlit/.
# There is deliberately no config.toml: the app uses Streamlit's built-in
# light/dark themes (see CLAUDE.md → Architecture → Theme). The negation stays
# so that if one is ever added back it is tracked, not silently ignored.
.streamlit/*
!.streamlit/config.toml

# Python
.venv/
__pycache__/
*.pyc

# Tools
.pytest_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# OS
.DS_Store
